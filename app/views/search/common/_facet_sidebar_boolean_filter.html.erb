<%# for things like 'online' or for_profit. Check the box sets it as false.  %>
<% facet_field ||= facet.field_name.to_s %>
<% enable_text ||= 'Only show online events' %>
<% disable_text ||= 'Show all events' %>
<% count ||= facet.rows.first.count %>

<%# Display all filter links %>
<% if @facet_params.include?(facet_field)  %>
  <li class="toggle-wrap mb-2 nav-item">
    <button type="submit" class="boolean-facet-button">
      <label class="toggle">
        <input type="checkbox" checked name="<%= facet_field %>" value="true">
        <span class="slider round"></span>
      </label>
      <span class="boolean-facet-label"><%= disable_text %></span>
    </button>
  </li>
<% else %>
  <li class="toggle-wrap mb-2 nav-item">
    <button type="submit" class="boolean-facet-button">
      <label class="toggle">
        <input type="checkbox" name="<%= facet_field %>" value="true">
        <span class="slider round"></span>
      </label>
      <span class="boolean-facet-label"><%= enable_text %></span>
    </button>
  </li>
<% end %>
